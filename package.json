{
  "name": "@omnidotdev/mantle-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "release": "changeset publish",
    "dev": "concurrently --kill-others --names \"GRAPHQL-CODEGEN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run graphql:generate:watch\" \"bun dev:vite\"",
    "dev:vite": "bun --env-file .env.local --env-file .env.development vite dev",
    "build": "tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "check": "biome check --diagnostic-level=error",
    "format": "biome format --write",
    "lint": "biome lint --diagnostic-level=error",
    "graphql:generate": "NODE_PATH=src/ dotenv-cli -e .env.development -- graphql-codegen --config src/lib/graphql/codegen.config.ts && bun scripts/postGraphqlGenerate.mjs",
    "graphql:generate:watch": "bun graphql:generate -w",
    "knip": "knip-bun",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "^5.40.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.16.0",
    "@internationalized/date": "^3.12.4",
    "@omnidotdev/providers": "github:omnidotdev/providers#v0.8.0",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#baea091695a4c0ccfce027117180edbe286d3628",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/zod-adapter": "^1.167.0",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "graphql": "^17.1.0",
    "graphql-request": "^7.4.0",
    "jose": "^6.2.18",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.79.0",
    "ms": "^2.1.3",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-hotkeys-hook": "^5.4.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "ts-pattern": "^5.9.2",
    "unleash-client": "^6.12.2",
    "usehooks-ts": "^3.1.1",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@graphql-codegen/add": "^8.0.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/import-types-preset": "^5.0.0",
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/typescript-graphql-request": "^8.0.2",
    "@graphql-codegen/typescript-operations": "^7.0.2",
    "@graphql-codegen/typescript-react-query": "^8.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.7",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.2",
    "@tanstack/react-devtools": "^0.10.15",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router-devtools": "^1.167.4",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv-cli": "^11.1.0",
    "husky": "^9.1.7",
    "knip": "^6.48.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "oxc-resolver",
    "sharp"
  ],
  "overrides": {
    "@internationalized/date": "^3.12.4",
    "@tanstack/router-core": "1.171.39"
  }
}
