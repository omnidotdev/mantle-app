{
  "name": "@omnidotdev/mantle-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "release": "changeset publish",
    "dev": "concurrently --kill-others --names \"GRAPHQL-CODEGEN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run graphql:generate:watch\" \"bun dev:vite\"",
    "dev:vite": "bun --env-file .env.local --env-file .env.development vite dev",
    "build": "tsc --noEmit && vite build",
    "start": "node .output/server/index.mjs",
    "check": "biome check --diagnostic-level=error",
    "format": "biome format --write",
    "lint": "biome lint --diagnostic-level=error",
    "graphql:generate": "NODE_PATH=src/ dotenv -e .env.development -- graphql-codegen --config src/lib/graphql/codegen.config.ts && bun scripts/postGraphqlGenerate.mjs",
    "graphql:generate:watch": "bun graphql:generate -w",
    "knip": "knip-bun",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "^5.34.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icons-pack/react-simple-icons": "^13.8.0",
    "@internationalized/date": "^3.11.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#v0.2.0",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#372ebb2",
    "@tanstack/react-form": "^1.28.3",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "1.167.4",
    "@tanstack/react-router-ssr-query": "^1.163.3",
    "@tanstack/react-start": "1.166.16",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-adapter": "^1.163.3",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.19",
    "graphql": "^16.13.0",
    "graphql-request": "^7.4.0",
    "jose": "^6.1.3",
    "libphonenumber-js": "^1.13.11",
    "lucide-react": "^0.562.0",
    "ms": "^2.1.3",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-hotkeys-hook": "^5.3.2",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ts-pattern": "^5.9.0",
    "unleash-client": "^6.9.6",
    "usehooks-ts": "^3.1.1",
    "zod": "4.3.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@graphql-codegen/add": "^7.0.1",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/plugin-helpers": "^7.0.1",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.4.1",
    "@tanstack/nitro-v2-vite-plugin": "^1.154.7",
    "@tanstack/react-devtools": "^0.9.6",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-router-devtools": "^1.163.3",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.3.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^5.85.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-mkcert": "^1.17.10",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "oxc-resolver",
    "sharp"
  ],
  "overrides": {
    "@internationalized/date": "^3.10.1"
  }
}
